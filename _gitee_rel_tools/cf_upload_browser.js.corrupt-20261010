// CurseForge 上传(浏览器页面上下文执行版)
//
// 为什么必须这样：authors-old.curseforge.com 的上传路径被 Cloudflare managed challenge 保护，
// Python 直连一律 403；首页不过盾所以偷不到 cf_clearance。唯一可行方式是在通过挑战的
// 页面里发同源 fetch(历史 _cf_driver.js 也是这个思路)。
//
// 与历史版本的区别：用 `agent-browser eval --stdin` 把整段 JS(内嵌 base64 文件)从标准输入送入，
// 绕开 Windows 命令行 ~32KB 参数长度限制，也省掉分块注入的复杂度。
//
// 用法: node cf_upload_browser.js --version=1.1.7 [--only=<jar名>] [--limit=N]
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const PUB = 'D:/桌面/voxlink/tools/publish';
const OUT = 'D:/桌面/voxlink/成品';
const AB = 'C:/Users/19430/.workbuddy/binaries/node/workspace/node_modules/agent-browser/bin/agent-browser.js';
const AB_CWD = 'C:/Users/19430/.workbuddy/binaries/node/workspace';
const DONE_FILE = path.join(PUB, '_cf_done_browser.json');

const args = process.argv.slice(2);
const VERSION = (args.find(a => a.startsWith('--version=')) || '').split('=')[1];
const ONLY = (args.find(a => a.startsWith('--only=')) || '').split('=')[1];
const LIMIT = parseInt((args.find(a => a.startsWith('--limit=')) || '--limit=0').split('=')[1], 10);

if (!VERSION) { console.error('缺 --version='); process.exit(1); }

const cfg = JSON.parse(fs.readFileSync(path.join(PUB, 'config.json'), 'utf8'));
const TOKEN = cfg.curseforge.upload_token;
const PROJECT_ID = String(cfg.curseforge.project_id);
const CHANGELOG = fs.readFileSync(path.join(PUB, `changelog-${VERSION}.md`), 'utf8');
const RELEASE_TYPE = 'beta';

// 与 cf_upload.py 完全相同的版本区间展开(改一处要同步另一处)
function expandMcRange(mcDir) {
  if (!mcDir.includes('_')) return [mcDir];
  const [a, b] = mcDir.split('_');
  const pa = a.split('.'), pb = b.split('.');
  if (pa.length === 3 && pb.length === 3) {
    const out = [];
    for (let i = +pa[2]; i <= +pb[2]; i++) out.push(`${pa[0]}.${pa[1]}.${i}`);
    return out;
  }
  if (pa.length === 2 && pb.length === 3) {
    const out = [a];
    for (let i = 1; i <= +pb[2]; i++) out.push(`${pa[0]}.${pa[1]}.${i}`);
    return out;
  }
  throw new Error(`无法解析版本区间: ${mcDir}`);
}

const LOADERS = { fabric: 'Fabric', forge: 'Forge', neoforge: 'NeoForge' };

function collect() {
  const items = [];
  for (const [lk, dname] of Object.entries(LOADERS)) {
    const d = path.join(OUT, dname);
    if (!fs.existsSync(d)) continue;
    for (const f of fs.readdirSync(d).sort()) {
      if (!f.startsWith(`voxlink-${VERSION}-`) || !f.endsWith('.jar')) continue;
      if (ONLY && f !== ONLY) continue;
      const stem = f.slice(`voxlink-${VERSION}-`.length, -4);
      const i = stem.lastIndexOf('-');
      const mcDir = stem.slice(0, i);
      items.push({ name: f, p: path.join(d, f), loader: LOADERS[lk], versions: expandMcRange(mcDir) });
    }
  }
  return items;
}

function runEval(script) {
  const r = spawnSync(process.execPath, [AB, 'eval', '--stdin'], {
    cwd: AB_CWD, input: script, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, timeout: 600000
  });
  return { out: (r.stdout || '') + (r.stderr || ''), code: r.status };
}

function buildScript(item) {
  const b64 = fs.readFileSync(item.p).toString('base64');
  const meta = {
    displayName: item.name,
    releaseType: RELEASE_TYPE,
    gameVersionNames: ['Client', item.loader, ...item.versions],
    changelog: CHANGELOG,
    changelogType: 'markdown',
  };
  // 注意：这段 JS 经 stdin 传入，不受命令行长度限制
  // 将 PROJECT_ID 和 TOKEN 作为常量注入到 eval 上下文中
  return `
(async () => {
  const PROJECT_ID = ${JSON.stringify(PROJECT_ID)};
  const TOKEN = ${JSON.stringify(TOKEN)};
  const b64 = ${JSON.stringify(b64)};
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  const fd = new FormData();
  fd.append('metadata', ${JSON.stringify(JSON.stringify(meta))});
  fd.append('file', new Blob([bytes], { type: 'application/java-archive' }), ${JSON.stringify(item.name)});
  try {
    const r = await fetch('/api/projects/' + PROJECT_ID + '/upload-file', {
      method: 'POST',
      headers: { 'X-Api-Token': TOKEN },
      body: fd,
    });
    const t = await r.text();
    return JSON.stringify({ status: r.status, body: t.slice(0, 300) });
  } catch (e) {
    return JSON.stringify({ status: -1, body: String(e) });
  }
})()
`;
}
  }
`;
}
  }
`;
}
  }
`;
}
  }
`;
}

// eval 把返回值序列化成 JSON 打印，而我们的脚本本身又返回 JSON 字符串，
// 所以输出是「JSON 编码的 JSON 字符串」，需要逐层解。
function parseResult(out) {
  const raw = out.trim();
  let v = raw.split('\n').filter(Boolean).pop() || raw;
  for (let i = 0; i < 4; i++) {
    try { v = JSON.parse(v); } catch (e) { return null; }
    if (v && typeof v === 'object' && 'status' in v) return v;
    if (typeof v !== 'string') return null;
  }
  return null;
}

let done = [];
try { done = JSON.parse(fs.readFileSync(DONE_FILE, 'utf8')); } catch (e) { }

// preflight
const pf = runEval('typeof window === "undefined" ? "no-window" : JSON.stringify({url: location.href, ua: navigator.userAgent.slice(0,60)})');
console.log('[预检]', pf.out.trim().slice(0, 200));
if (!/curseforge/i.test(pf.out)) {
  console.log('  ⚠ 当前页面不是 curseforge，请先在有头浏览器里打开 https://authors-old.curseforge.com/ 并过盾');
}

const items = collect();
console.log(`[CF] 版本 ${VERSION} | 待上传 ${items.length} 个 | 已完成 ${done.length} 个\n`);

let ok = 0, skip = 0, fail = 0;
for (const it of items) {
  if (done.includes(it.name)) { skip++; console.log(`  [跳过-已完成] ${it.name}`); continue; }
  if (LIMIT && ok >= LIMIT) break;
  process.stdout.write(`  [上传] ${it.name} (${(fs.statSync(it.p).size / 1048576).toFixed(2)}MB) ... `);
  const r = runEval(buildScript(it));
  const res = parseResult(r.out);
  if (res && res.status === 200) {
    ok++; done.push(it.name);
    fs.writeFileSync(DONE_FILE, JSON.stringify(done, null, 1));
    console.log('OK');
  } else if (res) {
    fail++;
    console.log(`FAIL status=${res.status} ${String(res.body).slice(0, 120)}`);
    if (res.status === 403) { console.log('  被盾拦截，中止。'); break; }
  } else {
    fail++;
    console.log('无法解析返回: ' + r.out.trim().slice(0, 200));
    break;
  }
}
console.log(`\n[CF] 上传 ${ok} 跳过 ${skip} 失败 ${fail}`);
