# 行尾统一 LF：scripts/*.sh 与 .github/workflows/*.yml 若被换成 CRLF，
# Linux runner 上会直接 "bad interpreter: /bin/bash^M" 或 YAML 解析异常。
* text=auto eol=lf
*.sh   text eol=lf
*.go   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.manifest text eol=lf
*.ico  binary
*.png  binary
*.exe  binary
